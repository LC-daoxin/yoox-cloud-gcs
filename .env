# YOOX Cloud GCS single-host deployment template
# Copy to .env before first start and replace every value containing "change_me".

COMPOSE_PROJECT_NAME=yoox-cloud-gcs
TZ=Asia/Shanghai

# Public addresses returned to browsers and devices. Do not use 127.0.0.1 for a
# remote dock; use the server LAN IP or a DNS name reachable by the device.
#YOOX_PUBLIC_HOST=172.20.10.8 192.168.2.199
YOOX_PUBLIC_HOST=192.168.66.88
YOOX_HTTP_PORT=8080
YOOX_PILOT_PORT=9000
YOOX_API_PORTAL_PORT=8081
YOOX_API_DIAGNOSTIC_PORT=19000
YOOX_PUBLIC_RTSP_PORT=8554
YOOX_WEBRTC_UDP_PORT=8189
YOOX_RTSP_USERNAME=yoox-publisher
YOOX_RTSP_PASSWORD=yoox_rtsp_local_dev

YOOX_DB_NAME=cloud_sample
YOOX_DB_USER=yoox
YOOX_DB_PASSWORD=yoox_db_local_dev
YOOX_DB_ROOT_PASSWORD=yoox_root_local_dev

YOOX_REDIS_PASSWORD=yoox_redis_local_dev
YOOX_JWT_SECRET=039338884044944f8bd8202a4e4a4b25a6c9b35d5ea1bba4ce76e8652fc7aa73

YOOX_MQTT_USERNAME=yoox-cloud
YOOX_MQTT_PASSWORD=yoox_mqtt_local_dev
YOOX_DEVICE_MQTT_USERNAME=pilot
YOOX_DEVICE_MQTT_PASSWORD=pilot123
YOOX_DEVICE_AUTO_REGISTER_ENABLED=true
YOOX_DEVICE_AUTO_REGISTER_WORKSPACE_ID=e3dea0f5-37f2-4d79-ae58-490af3228069
YOOX_EMQX_DASHBOARD_PASSWORD=yoox_emqx_local_dev

YOOX_MINIO_ACCESS_KEY=yoox_minio
YOOX_MINIO_SECRET_KEY=yoox_minio_local_dev
YOOX_MINIO_BUCKET=yoox-store

# Obtain these values from the device cloud developer console.
YOOX_CLOUD_APP_ID=local_dev_app_id
YOOX_CLOUD_APP_KEY=local_dev_app_key
YOOX_CLOUD_APP_LICENSE=local_dev_license

# Optional TURN settings. Enable with: docker compose --profile turn up -d
YOOX_TURN_REALM=yoox.local
YOOX_TURN_USERNAME=yoox-turn
YOOX_TURN_PASSWORD=yoox_turn_local_dev
YOOX_TURN_PORT=3478

YOOX_GRAFANA_ADMIN_PASSWORD=yoox_grafana_local_dev
YOOX_LOG_LEVEL=INFO
YOOX_JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

# Mac/Docker Desktop UDP 转发不可靠，本地必须用 TCP
YOOX_RTSP_TRANSPORTS=tcp
