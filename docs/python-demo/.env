# 本机 YOOX Cloud GCS 对应 demo 配置（由本地部署环境自动填充）
YOOX_SERVER_IP=127.0.0.1
YOOX_SERVER_PORT=8080

YOOX_PILOT_PORT=9000
YOOX_PILOT_BASE_URL=http://127.0.0.1:9000
YOOX_WS_URL=ws://127.0.0.1:9000/api/v1/ws

YOOX_WEB_USERNAME=admin
YOOX_WEB_PASSWORD=Yoox@123456
YOOX_WEB_FLAG=1

YOOX_PILOT_USERNAME=pilot
YOOX_PILOT_PASSWORD=pilot123
YOOX_PILOT_FLAG=2

YOOX_WORKSPACE_ID=e3dea0f5-37f2-4d79-ae58-490af3228069
# 网关（遥控器）SN 与无人机 SN：来自当前在线设备，更换设备后需要同步更新
YOOX_DOCK_SN=TH7926043417
YOOX_DRONE_SN=1748FEV3HMP925511143
YOOX_PAYLOAD_INDEX=10806-0-0

YOOX_MQTT_HOST=127.0.0.1
YOOX_MQTT_PORT=1883
YOOX_MQTT_WS_PORT=9001
YOOX_MQTT_USERNAME=
YOOX_MQTT_PASSWORD=

YOOX_RTSP_HOST=127.0.0.1
YOOX_RTSP_PORT=8554

# demo_08 / demo_10 共用；也可以在命令行用 --lat/--lon/--height/--speed 覆盖。
# 一键起飞通常应把目标经纬度设为飞机当前有效 GPS 坐标，只改变高度。
YOOX_TARGET_LATITUDE=39.041622
YOOX_TARGET_LONGITUDE=117.72417
YOOX_TARGET_HEIGHT=2
YOOX_TARGET_MAX_SPEED=5

YOOX_HTTP_CONNECT_TIMEOUT=5
YOOX_HTTP_CONTROL_TIMEOUT=20
YOOX_POINT_FLIGHT_WAIT_SECONDS=300
