# MediaMTX input path. The normalized output is published with -normalized.
YOOX_RTSP_NORMALIZER_SOURCE_PATH=replace_with_live_stream_path
# Default wallclock rebuilds timestamps from arrival times.
# Use rtp-microseconds ONLY after ingress capture confirms microsecond ticks
# were incorrectly published as H264/90000. Correct streams must not use it.
YOOX_RTSP_NORMALIZER_TIMESTAMP_MODE=wallclock
