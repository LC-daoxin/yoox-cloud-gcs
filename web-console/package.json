{
  "name": "yoox-cloud-gcs-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run tests/map.spec.ts tests/whep.spec.ts tests/video-sessions.spec.ts tests/device-status.spec.ts",
    "test:dashboard": "playwright test --config tests/dashboard.config.ts",
    "test:map-browser": "playwright test --config tests/playwright.config.ts",
    "test:multi-device": "playwright test --config tests/multi-device.config.ts"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "leaflet": "1.9.4",
    "maplibre-gl": "6.15.0",
    "mqtt": "5.10.3",
    "pinia": "2.3.1",
    "pmtiles": "4.5.0",
    "protomaps-leaflet": "5.1.0",
    "vue": "3.5.13",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.22",
    "@vitejs/plugin-vue": "5.2.1",
    "typescript": "5.7.3",
    "vite": "6.1.0",
    "vitest": "3.2.7",
    "vue-tsc": "2.2.0"
  }
}
